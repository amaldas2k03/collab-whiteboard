# Port the WebSocket + HTTP server binds to.
#
# Local dev sets WS_PORT=8080 automatically (see the "dev" script in
# package.json), so you normally don't need this file for local work.
#
# Hosts like Render/Railway inject PORT; the server uses it when WS_PORT is
# unset. Precedence: WS_PORT > PORT > 8080.
# WS_PORT=8080
# PORT=8080
