# Port the WebSocket + HTTP server binds to.
#
# Local dev sets WS_PORT=8080 automatically (see the "dev" script in
# package.json), so you normally don't need this file for local work.
#
# Hosts like Render/Railway inject PORT; the server uses it when WS_PORT is
# unset. Precedence: WS_PORT > PORT > 8080.
# WS_PORT=8080
# PORT=8080

# --- Photo import (POST /api/import-photo) ---------------------------------
# Server-side only; never put this in the client's VITE_* vars.
# Without it the import button reports "not configured" and nothing else breaks.
# ANTHROPIC_API_KEY=sk-ant-...
# Vision adapter (see server/src/vision.ts) and the model it uses.
# VISION_PROVIDER=anthropic
# VISION_MODEL=claude-opus-5
# Origin allowed to call the route (the Vercel client URL). Defaults to *.
# CORS_ORIGIN=https://your-app.vercel.app
