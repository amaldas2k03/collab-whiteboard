# WebSocket server URL the client connects to.
#
# Local dev: leave as-is (or unset) to reach the dev server on :8080.
#
# Production: set this in your Vercel project env vars to the deployed server,
# using wss:// (an HTTPS page refuses plaintext ws:// as mixed content):
#   VITE_WS_URL=wss://collab-whiteboard-server.onrender.com
#
# VITE_* values are inlined at BUILD time, so redeploy after changing this.
VITE_WS_URL=ws://localhost:8080
